{
  "name": "delphi-code-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:export": "${DELPHI_CODE_PYTHON:-$(dirname \"$PWD\")/.venv/bin/python} ../scripts/export_openapi.py > openapi.json",
    "api:types": "openapi-typescript openapi.json --output src/api/schema.d.ts",
    "api:generate": "${DELPHI_CODE_PYTHON:-$(dirname \"$PWD\")/.venv/bin/python} ../scripts/export_openapi.py > openapi.json && openapi-typescript openapi.json --output src/api/schema.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "clsx": "2.1.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.41",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
